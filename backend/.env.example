# DATABASE CONFIGURATION
DB_HOST=localhost
DB_USER=root
DB_PASS=password
DB_NAME=noticehub_db
DB_PORT=3306

# SERVER CONFIGURATION
PORT=5000
NODE_ENV=development

# SECURITY CONFIGURATION
# Generate a strong secret via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=supersecretkey_change_in_production

# INITIAL ADMIN BOOTSTRAPPING (seedAdmin)
# These credentials will be used to create the first admin account on startup
ADMIN_NAME=Super Admin
ADMIN_EMAIL=admin@test.com
ADMIN_PASSWORD=Admin@123
